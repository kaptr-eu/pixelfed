# vue-blurhash@0.1.4 declares peer blurhash@^1.1.3 while the project uses
# blurhash@^2.0.5. The decode() API used in resources/assets/js is unchanged
# between v1 and v2, so the peer range is stale, not a real incompatibility.
# Upstream pixelfed carries the same conflict. Without this, npm ci/install
# fails with ERESOLVE on every machine.
legacy-peer-deps=true
